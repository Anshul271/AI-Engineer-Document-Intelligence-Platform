@"
# --- General ---
ENV=development

# --- Database ---
DATABASE_URL=sqlite:///./docintel.db

# --- File constraints ---
MAX_PAGES=3
MAX_FILE_SIZE_MB=15

# --- LLM extraction (Google Gemini) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- OCR ---
TESSERACT_CMD=
OCR_DPI=200

# --- Storage ---
UPLOAD_DIR=./storage/uploads

# --- Financial validation tolerance ---
NUMERIC_TOLERANCE=0.01
"@ | Set-Content .env.example