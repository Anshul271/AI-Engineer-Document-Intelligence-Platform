# Copy this file to .env and fill in real values. Never commit .env itself.

# --- General ---
ENV=development

# --- Database (defaults to local SQLite file if unset) ---
DATABASE_URL=sqlite:///./docintel.db

# --- File constraints ---
MAX_PAGES=3
MAX_FILE_SIZE_MB=15

# --- LLM extraction (Anthropic Claude) ---
GEMINI_API_KEY=Your api key
GEMINI_MODEL=gemini-2.5-flash
# --- OCR ---
# Only needed if tesseract is not on PATH
TESSERACT_CMD=your tesseract path
OCR_DPI=200

# --- Storage ---
UPLOAD_DIR=./storage/uploads

# --- Financial validation tolerance (fraction, e.g. 0.01 = 1%) ---
NUMERIC_TOLERANCE=0.01
